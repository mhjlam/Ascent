material Ascent/Caution
{
	technique
	{
		pass
		{
			ambient 0.15 0.15 0.05
			diffuse 0.5 0.5 0.2
			specular 0.1 0.1 0.05 8
			
			texture_unit
			{
				texture caution.jpg
			}
		}
		
		// Emissive glow pass - only where mask is white (yellow stripes)
		pass
		{
			scene_blend add
			depth_write off
			lighting off
			
			texture_unit
			{
				texture caution_emissive.jpg
				colour_op_ex modulate src_texture src_manual 2.5 2.0 0.0
			}
		}
	}
}
